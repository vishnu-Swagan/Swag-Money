{
  "name": "@swag-money/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview -- --port 8788 --ip 127.0.0.1",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --keep-vars",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/instrument-sans": "^5.2.5",
    "@fontsource/instrument-serif": "^5.2.5",
    "@swag-money/api": "workspace:*",
    "@swag-money/shared": "workspace:*",
    "@opennextjs/cloudflare": "^1.11.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "wrangler": "^4.40.0"
  }
}
