# Copy to .env for local `pnpm dev` overrides. Never commit real secrets.
# The Worker reads secrets and vars from Cloudflare, not from this file.
# Preview uses packages/web/.dev.vars (see .dev.vars.example).

# Local only. pnpm dev sets this so the site talks to the PGlite API on port 8787.
# Leave unset for the Worker. The Worker serves /v1 on the same host.
SWAG_API_URL=http://127.0.0.1:8787

# Local API listen port and embedded-database directory. Ignored by the Worker.
SWAG_API_PORT=8787
SWAG_DATA_DIR=./data

# production refuses demo seeding. wrangler.jsonc sets this on the Worker.
SWAG_ENV=

# 1 locally (default) enables demo session routes. Forced off when SWAG_ENV=production.
SWAG_ALLOW_DEMO=1

# Postgres URL. Local pnpm dev ignores this and uses PGlite.
# pnpm db:migrate applies the schema in Node. The Worker does not migrate on startup.
# Production: Neon direct URL (not the -pooler host), stored as a Worker secret.
# Preview: a local Postgres URL in packages/web/.dev.vars.
DATABASE_URL=

# Set to 1 to make pnpm db:migrate fail when DATABASE_URL is missing.
SWAG_REQUIRE_DATABASE=

# base64url 32-byte Ed25519 seed. Generate with: pnpm -s keys
# Worker secret. Locally, an empty value writes data/signing-key.json on first boot of pnpm dev.
SWAG_SIGNING_PRIVATE_KEY=

# base64url Ed25519 public key. Generate with: pnpm -s keys
# Plain Worker var, not a secret. Must match the private seed or the Worker refuses to boot.
SWAG_SIGNING_PUBLIC_KEY=

# At least 16 characters. Generate with: pnpm -s keys
# Worker secret. Locally, an empty value writes data/session-secret on first boot of pnpm dev.
SWAG_SESSION_SECRET=

# Public origin, including https://. Worker var. Example: https://swagmoney.ai
SWAG_PUBLIC_SITE_URL=

# Developer share in basis points. 5000 is 50%. Worker var. Integer from 0 to 10000.
SWAG_DEVELOPER_SHARE_BPS=5000

# Comma-separated emails allowed into /admin. Worker var, not a secret. Empty means nobody.
# The person still signs in with the normal login. Anyone else gets a 404.
ADMIN_EMAILS=

# Off by default. 1 records a mock email when an advertiser signs up. No mail is sent.
# A real provider would replace the mock adapter in packages/api/src/notify.ts (see DEPLOY.md).
SWAG_ADMIN_NOTIFY=0
SWAG_ADMIN_NOTIFY_TO=

# Attention and payout policy. Defaults match the product rules when unset.
SWAG_MIN_VIEW_MS=5000
SWAG_PAYOUT_MIN_CENTS=1000
SWAG_IMPRESSION_TTL_MS=120000

# Payout providers stay mocked until a test key is present. No network call is made.
# Stripe sk_live_ and Razorpay rzp_live_ are refused. Do not add live keys.
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=
SOLANA_RPC_URL=
SOLANA_PAYOUT_SECRET_KEY=
LIGHTNING_NODE_URL=
LIGHTNING_MACAROON=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
