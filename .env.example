# Copy to .env for local overrides. Never commit real secrets.
# Production reads these from the Vercel project. See DEPLOY.md.

# Local only. pnpm dev sets this so the site talks to the PGlite API on port 8787.
# Leave unset on Vercel. The Next.js app serves /v1 on the same domain.
SWAG_API_URL=http://127.0.0.1:8787

# Local API listen port and embedded-database directory. Ignored on Vercel.
SWAG_API_PORT=8787
SWAG_DATA_DIR=./data

# Set to production to refuse demo seeding. Vercel sets VERCEL for you.
SWAG_ENV=

# 1 locally (default) enables demo session routes. Forced off when hosted.
SWAG_ALLOW_DEMO=1

# Hosted Postgres. Neon pooled URL (host contains -pooler) or Supabase port 6543.
# Local pnpm dev ignores this and uses PGlite. pnpm db:migrate applies the schema.
DATABASE_URL=

# Set to 1 to make pnpm db:migrate fail when DATABASE_URL is missing. Vercel does this via VERCEL.
SWAG_REQUIRE_DATABASE=

# base64url 32-byte Ed25519 seed. Generate with: pnpm -s keys
# Required in production. Locally, an empty value writes data/signing-key.json on first boot.
SWAG_SIGNING_PRIVATE_KEY=

# At least 16 characters. Generate with: pnpm -s keys
# Required in production. Locally, an empty value writes data/session-secret on first boot.
SWAG_SESSION_SECRET=

# Public origin of this deployment, including https://. Example: https://swagmoney.ai
# Required in production. Used as the metadata base URL.
SWAG_PUBLIC_SITE_URL=

# Developer share in basis points. 5000 is 50%. Required in production (0 through 10000).
SWAG_DEVELOPER_SHARE_BPS=5000

# Attention and payout policy. Defaults match the product rules when unset.
SWAG_MIN_VIEW_MS=5000
SWAG_PAYOUT_MIN_CENTS=1000
SWAG_IMPRESSION_TTL_MS=120000

# Payout providers stay mocked until a test key is present. No network call is made.
# Stripe sk_live_ and Razorpay rzp_live_ are refused. Do not add live keys.
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=
SOLANA_RPC_URL=
SOLANA_PAYOUT_SECRET_KEY=
LIGHTNING_NODE_URL=
LIGHTNING_MACAROON=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
