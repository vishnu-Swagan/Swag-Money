# Copy to .env for local overrides. Never put production secrets in this file.
# Empty values are intentional: the API generates a signing key and a session
# secret under SWAG_DATA_DIR on first boot and does not print the private key.

SWAG_ALLOW_DEMO=1
SWAG_API_PORT=8787
SWAG_API_URL=http://127.0.0.1:8787
SWAG_DATA_DIR=./data

# 32-byte Ed25519 seed, base64url. Leave empty to auto-generate under SWAG_DATA_DIR.
# A generated key is a local secret. Do not commit data/signing-key.json.
SWAG_SIGNING_PRIVATE_KEY=

# Used only if you want a stable demo session secret. Otherwise one is generated in data/.
SWAG_SESSION_SECRET=

# This MVP opens embedded Postgres (PGlite) at SWAG_DATA_DIR.
# DATABASE_URL is not read. The SQL in packages/api/src/db.ts is ordinary Postgres
# if you later swap the driver.
DATABASE_URL=

# Attention and payout policy. Defaults match the product rules.
SWAG_MIN_VIEW_MS=5000
SWAG_PAYOUT_MIN_CENTS=1000
SWAG_IMPRESSION_TTL_MS=120000
# Developer share in basis points. 5000 is 50%. 7000 would be 70%.
SWAG_DEVELOPER_SHARE_BPS=5000

# Payout providers. Leave unset to stay in mock mode (no network calls).
# Stripe: an sk_test_ key selects sandbox mode. sk_live_ keys are refused.
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=
# Solana and Lightning stay mock/sandbox. This build never broadcasts.
SOLANA_RPC_URL=
SOLANA_PAYOUT_SECRET_KEY=
LIGHTNING_NODE_URL=
LIGHTNING_MACAROON=
# Presence of a provider key only flips the receipt into sandbox mode.
# No outbound credit-grant request is sent.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# UPI via RazorpayX. rzp_test_ selects sandbox mode. rzp_live_ is refused.
# Leave empty for a local mock receipt. No network call is made either way.
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
